# ==========================================
# Antigravity & AI Assistant Ignore Rules
# ==========================================

# Dependencies & Package Managers
**/node_modules/
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml
**/bun.lockb

# Build Outputs & Bundles
**/dist/
**/dist-ssr/
**/build/
**/out/
**/.next/
**/.nuxt/
**/.output/
**/.vercel/
**/.turbo/

# Logs & Temporary Files
**/*.log
**/logs/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*
**/.tmp/
**/tmp/
**/temp/
**/*.tmp

# Environment & Secret Files
**/.env
**/.env.*
!**/.env.example

# IDE & Editor Settings
**/.idea/
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
**/*.swp
**/*.swo
**/*.sublime-*
.DS_Store
Thumbs.db

# Git Internals & Internal AI Brain/Logs
**/.git/
**/.gemini/
**/.system_generated/

# Media Assets & Binaries (heavy files)
**/*.mp4
**/*.mov
**/*.avi
**/*.mp3
**/*.wav
**/*.ogg
**/*.flac
**/*.zip
**/*.tar.gz
**/*.rar
**/*.7z
**/*.pdf
**/*.iso
