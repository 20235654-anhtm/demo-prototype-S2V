# ==========================================
# Root Git Ignore
# ==========================================

# Dependencies
node_modules/
**/node_modules/

# Production Builds
dist/
dist-ssr/
build/
**/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
.env
.env*.local
.env.production
.env.development

# Editor & OS files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# Large media files / exports (if generated locally)
*.mp4
*.mp3
*.wav
*.zip
